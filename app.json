{
  "expo": {
    "name": "Pathrix",
    "slug": "pathrix",
    "scheme": "pathrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#A45F34",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pathrix.game",
      "buildNumber": "1",
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "We use this to show you relevant ads and improve your experience."
      }
    },
    "android": {
      "package": "com.pathrix.game",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.224820063552-g2ir4kdupesb026opjvfgpg2q4e4iu4j"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9218730809381271~3013593648",
          "iosAppId": "ca-app-pub-9218730809381271~9644887508"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "./plugins/withAndroidAnnotationsFix",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-localization",
      "expo-tracking-transparency"
    ],
    "extra": {
      "eas": {
        "projectId": "c0dcace4-b9c3-4668-badf-2a8f87d05c7d"
      }
    },
    "owner": "ronald.herrera"
  }
}
